{
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__navigate",
      "Bash(curl -s https://raw.githubusercontent.com/garrytan/gstack/main/README.md -o /tmp/claude-0/-opt-autosparefinder/5a0e32e4-b6ab-41db-83a3-98b7ecfef8b2/scratchpad/gstack_readme.md)",
      "Bash(python3 -)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-sonnet-5-5",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/restart_guard_hook.py\""
          }
        ]
      }
    ]
  }
}
