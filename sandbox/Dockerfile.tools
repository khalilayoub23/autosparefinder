# =============================================================================
# AutoSpareFinder — Pentest / Security Toolbox
# Base: alpine (already cached), minimal footprint
# =============================================================================

FROM alpine:latest

LABEL maintainer="AutoSpareFinder Security Sandbox"
LABEL description="Pentest toolbox: nmap, sqlmap, ffuf, nuclei, gobuster, nikto, hydra + Python"

# ── System tools ──────────────────────────────────────────────────────────────
RUN apk add --no-cache \
    bash curl wget git jq \
    python3 py3-pip \
    nmap nmap-scripts \
    nikto \
    hydra \
    netcat-openbsd \
    whois \
    bind-tools \
    openssl \
    ca-certificates \
    vim nano \
    tmux \
    perl \
    unzip \
    less \
    procps

# ── Python security + utility libraries ───────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages \
    sqlmap \
    requests \
    httpx \
    aiohttp \
    beautifulsoup4 \
    PyJWT \
    rich \
    python-dotenv \
    faker \
    colorama \
    tabulate \
    pyyaml \
    Pillow \
    dnspython

# ── jwt_tool (JWT security testing) ──────────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages jwt_tool 2>/dev/null || \
    git clone --depth 1 https://github.com/ticarpi/jwt_tool.git /opt/jwt_tool && \
    ln -sf /opt/jwt_tool/jwt_tool.py /usr/local/bin/jwt_tool && \
    chmod +x /usr/local/bin/jwt_tool || true

# ── Go binaries: ffuf, gobuster, nuclei ───────────────────────────────────────
# ffuf — fast web fuzzer (essential for endpoint discovery)
RUN wget -q "https://github.com/ffuf/ffuf/releases/download/v2.1.0/ffuf_2.1.0_linux_amd64.tar.gz" \
        -O /tmp/ffuf.tar.gz && \
    tar -xf /tmp/ffuf.tar.gz -C /usr/local/bin ffuf && \
    chmod +x /usr/local/bin/ffuf && \
    rm /tmp/ffuf.tar.gz && \
    echo "ffuf $(ffuf -V 2>&1 | head -1) installed"

# gobuster — directory/DNS brute-forcer
RUN wget -q "https://github.com/OJ/gobuster/releases/download/v3.6.0/gobuster_Linux_x86_64.tar.gz" \
        -O /tmp/gobuster.tar.gz && \
    tar -xf /tmp/gobuster.tar.gz -C /usr/local/bin gobuster && \
    chmod +x /usr/local/bin/gobuster && \
    rm /tmp/gobuster.tar.gz && \
    echo "gobuster installed"

# nuclei — automated vulnerability scanner
RUN wget -q "https://github.com/projectdiscovery/nuclei/releases/download/v3.3.7/nuclei_3.3.7_linux_amd64.zip" \
        -O /tmp/nuclei.zip && \
    unzip -q /tmp/nuclei.zip nuclei -d /usr/local/bin/ && \
    chmod +x /usr/local/bin/nuclei && \
    rm /tmp/nuclei.zip && \
    echo "nuclei installed"

# ── Download nuclei templates (web-related only to save space) ────────────────
RUN nuclei -update-templates -silent 2>/dev/null || true

# ── Workspace setup ───────────────────────────────────────────────────────────
WORKDIR /workspace

# Pre-create output directories
RUN mkdir -p /workspace/{tests,wordlists,results,scripts}

# ── Entrypoint helper banner ──────────────────────────────────────────────────
RUN cat > /etc/profile.d/sandbox_banner.sh << 'EOF'
echo ""
echo "  ╔══════════════════════════════════════════════════════════════╗"
echo "  ║         AutoSpareFinder  —  Security Sandbox Toolbox         ║"
echo "  ╠══════════════════════════════════════════════════════════════╣"
echo "  ║  TARGET (sandbox):  http://sandbox_backend:8000              ║"
echo "  ║  TARGET (external): https://autosparefinder.co.il            ║"
echo "  ╠══════════════════════════════════════════════════════════════╣"
echo "  ║  Tools: nmap  nikto  hydra  sqlmap  ffuf  gobuster  nuclei   ║"
echo "  ║  Python: requests  httpx  PyJWT  aiohttp  beautifulsoup4     ║"
echo "  ╠══════════════════════════════════════════════════════════════╣"
echo "  ║  /workspace/tests/     — your test scripts                   ║"
echo "  ║  /workspace/wordlists/ — fuzzing lists                       ║"
echo "  ║  /workspace/results/   — scan output (persisted)             ║"
echo "  ╚══════════════════════════════════════════════════════════════╝"
echo ""
EOF

CMD ["bash", "--login"]
